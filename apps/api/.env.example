# Runtime
NODE_ENV=development
PORT=3001
# Comma-separated allowlist for CORS (required in production)
CORS_ORIGIN=http://localhost:3000
# Number of trusted reverse-proxy hops (0 when no proxy)
TRUST_PROXY_HOPS=0

# Database (see docker-compose.yml for local dev)
DATABASE_URL=postgresql://prime:prime@localhost:5432/prime_agentic?schema=public

# Email provider (console | smtp | resend — production must NOT use console)
EMAIL_PROVIDER=console
SALES_INBOX_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Bot protection (Turnstile; required in production)
TURNSTILE_SECRET_KEY=
